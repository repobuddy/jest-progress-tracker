{
	"name": "jest-progress-tracker",
	"version": "4.0.0",
	"description": "Keep track of test progress over time",
	"keywords": [
		"jest",
		"reporters"
	],
	"homepage": "https://github.com/repobuddy/jest-progress-tracker",
	"bugs": {
		"url": "https://github.com/repobuddy/jest-progress-tracker/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/repobuddy/jest-progress-tracker.git"
	},
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./esm/index.d.ts",
			"default": "./esm/index.js"
		}
	},
	"main": "esm/index.js",
	"typings": "esm/index.d.ts",
	"files": [
		"esm",
		"ts",
		"!**/*.{spec,test,unit,accept,integrate,system,perf,stress,study,stories}.*"
	],
	"scripts": {
		"build": "tsdown",
		"check": "biome check",
		"check:fix": "biome check --fix",
		"clean": "rimraf cjs esm coverage .turbo",
		"coverage": "jest --coverage",
		"cs": "changeset",
		"depcheck": "depcheck",
		"format": "biome format . --write",
		"lint": "biome lint .",
		"nuke": "pnpm clean && rimraf node_modules",
		"prepare": "husky",
		"release": "changeset publish",
		"test": "jest",
		"typecheck": "tsc",
		"verify": "run-p lint verify:pkg",
		"verify:pkg": "turbo run build typecheck coverage depcheck",
		"version": "changeset version",
		"watch": "jest --watch"
	},
	"dependencies": {
		"@jest/test-result": "^29.0.0 || ^30.0.0",
		"istanbul-lib-coverage": "^3.2.2",
		"test-progress-tracker": "^2.0.8"
	},
	"devDependencies": {
		"@babel/core": "^8.0.0",
		"@babel/preset-env": "^8.0.0",
		"@babel/preset-typescript": "^8.0.0",
		"@biomejs/biome": "^2.5.11",
		"@changesets/cli": "^3.0.0",
		"@commitlint/cli": "^21.0.0",
		"@commitlint/config-conventional": "^21.0.0",
		"@repobuddy/biome": "^2.3.1",
		"@types/istanbul-lib-coverage": "^2.0.6",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.12.2",
		"assertron": "^11.5.4",
		"babel-jest": "^30.0.0",
		"depcheck": "^1.4.7",
		"husky": "^9.1.7",
		"jest": "^30.0.0",
		"jest-watch-suspend": "^1.1.2",
		"jest-watch-toggle-config": "^2.0.1",
		"npm-run-all2": "^9.0.0",
		"rimraf": "^6.0.1",
		"satisfier": "^5.4.4",
		"tsdown": "^0.23.0",
		"turbo": "^2.10.3",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"jest": ">=27.0.0"
	},
	"packageManager": "pnpm@11.21.0",
	"engines": {
		"node": "^20.19.0 || ^22.13.0 || >=24"
	}
}
