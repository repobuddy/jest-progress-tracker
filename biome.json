{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
	"extends": ["@repobuddy/biome/recommended"],
	"files": {
		"includes": [
			"!**/.turbo",
			"!**/cjs",
			"!**/esm",
			"!**/coverage",
			"!**/node_modules",
			"!skills-lock.json",
			"!pnpm-lock.yaml",
			"!.progress"
		]
	},
	"javascript": {
		"formatter": {
			"trailingCommas": "none"
		}
	}
}
